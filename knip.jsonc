{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "solutions/frontend/src/lambda.ts!",
        "solutions/frontend/src/local.ts!",
        "solutions/frontend/rolldown.config.ts!",
        "solutions/frontend/rolldown.local.config.ts!",
      ],
      "ignore": ["solutions/frontend/src/static/application.scss"],
      "ignoreBinaries": [
        "zizmor",
        "brew",
        "pre-commit",
        "read",
        "sam",
        "detect-secrets",
        "checkov",
        "concurrently",
      ],
      "ignoreDependencies": [
        "csso-cli",
        "@govuk-one-login/frontend-device-intelligence",
      ],
    },
    "solutions/integration-tests": {
      "entry": ["tests/steps/**/*.ts!", "playwright.config.ts!"],
      "playwright": {
        "config": [],
      },
    },
  },
}
