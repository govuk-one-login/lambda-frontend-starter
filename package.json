{
  "name": "CHANGEME",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.33.1",
    "@aws-lambda-powertools/metrics": "^2.33.1",
    "@aws-sdk/client-dynamodb": "^3.1081.0",
    "@aws-sdk/lib-dynamodb": "^3.1081.0",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^10.0.0",
    "@govuk-one-login/frontend-analytics": "^4.2.0",
    "@govuk-one-login/frontend-device-intelligence": "^1.2.0",
    "@govuk-one-login/frontend-ui": "^5.3.0",
    "@smithy/node-http-handler": "^4.7.1",
    "aws-xray-sdk": "^3.12.0",
    "cookie": "^2.0.1",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "govuk-frontend": "^5.14.0",
    "i18next": "^26.3.4",
    "i18next-http-middleware": "^3.9.7",
    "nunjucks": "^3.2.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.13.3",
    "@types/nunjucks": "^3.2.6",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.21",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.4",
    "csso-cli": "^4.0.2",
    "eslint": "^10.6.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-playwright": "^2.10.5",
    "knip": "^6.25.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.4",
    "rolldown": "1.1.4",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "install-brewfile": "cat Brewfile; echo; echo; read -p \"Install/update Brewfile dependencies as shown above (y/N)?\" -n 1 -r; echo; if [ \"$REPLY\" == \"y\" ]; then brew bundle check || brew bundle install; fi",
    "install-git-hooks": "pre-commit install --install-hooks --overwrite",
    "audit": "npm audit --audit-level=moderate --omit=dev && npm audit signatures && cd solutions/integration-tests && npm run audit",
    "check-types": "tsc --noEmit",
    "eslint": "eslint . --report-unused-disable-directives --cache --max-warnings 0",
    "eslint:fix": "eslint . --fix --report-unused-disable-directives --cache --max-warnings 0",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "knip": "knip --production",
    "knip:fix": "knip --production --fix --allow-remove-files",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "detect-secrets": "git ls-files -z | xargs -0 detect-secrets-hook --verbose --baseline .secrets.baseline",
    "detect-secrets-recreate": "detect-secrets scan --slim > .secrets.baseline",
    "zizmor": "zizmor .github/",
    "zizmor:fix": "zizmor .github/ --fix",
    "checkov": "checkov --directory ./",
    "sam-validate": "sam validate --region eu-west-2 --lint -t solutions/app-infra/template.yaml",
    "build": "cd solutions/frontend && bash ./build/production.sh",
    "build-local": "cd solutions/frontend && bash ./build/local.sh",
    "watch": "chokidar \"./solutions/frontend/src/**/*\" -c \"npm run build-local\"",
    "start": "bash solutions/local-aws/provision.sh && npm run build-local && concurrently 'npm run watch' 'cd solutions/frontend && node --enable-source-maps --watch --env-file=$([ \"$IS_INTEGRATION_TEST\" = \"1\" ] && echo \".env.integration-tests\" || echo \".env\") ./dist/local.js' --kill-others"
  }
}
